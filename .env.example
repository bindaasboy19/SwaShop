PORT=5001
NODE_ENV=development
# MongoDB connection URI (optional: falls back to embedded persistent database if empty/offline)
MONGODB_URI=mongodb://localhost:27017/swashop
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Platform Administrator Seed Credentials
ADMIN_NAME=SwaShop Administrator
ADMIN_EMAIL=admin@swashop.in
ADMIN_PASSWORD=AdminPass@12345

# Cloudinary Storage & AI Image Enhancement (Optional - supports local storage fallback)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Provider Configuration (Phase 2)
# Supported: gemini, fallback
AI_PROVIDER=gemini
# Modern Gemini models: gemini-2.5-flash, gemini-3.7-flash
AI_MODEL=gemini-2.5-flash
# Optional: Google Gemini API Key (If omitted, automatic high-fidelity fallback intelligence is utilized)
GEMINI_API_KEY=
