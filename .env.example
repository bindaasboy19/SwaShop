# ==============================================================================
# SwaShop Master Environment Configuration
# ==============================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Database URI (e.g. MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/swashop?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=swashop_super_secret_jwt_key_2026

# Frontend Live URL (For Backend CORS - e.g. Vercel or Netlify)
CLIENT_URL=https://swashop.vercel.app, https://swashop.netlify.app

# Frontend Live Backend Connection (Set this in Vercel/Netlify Environment Variables)
VITE_API_BASE_URL=https://swashop-api.onrender.com

# Initial Platform Administrator Seed Credentials
ADMIN_NAME=SwaShop Administrator
ADMIN_EMAIL=admin@swashop.in
ADMIN_PASSWORD=AdminPass@12345

# Optional Cloudinary Storage (Optional, supports local storage fallback)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional AI Configuration (Optional, has high-fidelity offline fallback)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key
