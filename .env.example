# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Configuration
# Leave empty or set to mongodb://127.0.0.1:27017/swashop
# If local MongoDB is not found, an embedded instance will start automatically
MONGODB_URI=

# Authentication Secret
JWT_SECRET=swashop_super_secret_jwt_key_phase1_2026

# Seed Admin Credentials (for npm run seed:admin)
ADMIN_NAME=SwaShop Administrator
ADMIN_EMAIL=admin@swashop.in
ADMIN_PASSWORD=AdminPass@12345

# Optional Cloudinary Configuration (defaults to local /uploads storage if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
