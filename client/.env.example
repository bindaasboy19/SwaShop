# ==============================================================================
# SwaShop Frontend Environment Configuration (.env.production / Vercel / Netlify)
# ==============================================================================

# In Production on Vercel / Netlify:
# Set this environment variable in Vercel/Netlify Dashboard > Settings > Environment Variables:
# Replace with your actual deployed Render backend URL:
VITE_API_BASE_URL=https://swashop-api.onrender.com

# For Local Development (automatically defaults to http://localhost:5001 via Vite proxy):
# VITE_API_BASE_URL=http://localhost:5001
