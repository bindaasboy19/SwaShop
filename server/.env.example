# ==============================================================================
# SwaShop Backend Environment Configuration (Render / Railway / Server)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5001

# MongoDB Connection String (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/swashop?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=swashop_super_secret_jwt_production_key_2026

# Frontend URL (For CORS protection - enter your Vercel or Netlify frontend URL)
CLIENT_URL=https://swashop.vercel.app

# Optional AI & Cloud Integrations (Optional, has automatic local fallbacks):
# GEMINI_API_KEY=your_gemini_api_key_here
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

